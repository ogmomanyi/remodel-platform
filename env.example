# Kota Designs — local/deployment environment
# Never commit real values. Use .env.local locally and Vercel Environment Variables in production.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=use-a-strong-admin-password
ADMIN_SESSION_SECRET=use-a-separate-long-random-secret
POLLINATIONS_API_KEY=your-pollinations-secret-key

# Optional visualisation model overrides
POLLINATIONS_MODEL=flux
POLLINATIONS_EDIT_MODEL=klein
